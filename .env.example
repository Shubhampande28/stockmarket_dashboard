UPSTOX_CLIENT_ID=your_upstox_api_key
UPSTOX_CLIENT_SECRET=your_upstox_api_secret
UPSTOX_REDIRECT_URI=http://localhost:5000/callback
# 1-year Upstox Analytics Token (Upstox Developer Apps -> Analytics tab -> Generate Token).
# Read first by token_manager.load_token(); leave unset to fall back to the OAuth flow below.
UPSTOX_ACCESS_TOKEN=
ADMIN_USERNAME=change_this_username
ADMIN_PASSWORD=change_this_password
FLASK_SECRET_KEY=change_this_random_secret
OPENAI_API_KEY=optional_for_news_summaries
APIFY_TOKEN=optional_for_screener_financials
APIFY_SCREENER_ACTOR_ID=optional_actor_id_or_username/actor-name
# Set to 1 to build/run against backend/fixtures/ instead of live Upstox/NSE calls.
EQUILYTICS_SAMPLE_DATA=0
